import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;

public class Main {
    
    public int minSumOfLengths(int[] arr, int target) {
        int n = arr.length;
        // minLens[i] stores the minimum length of a valid subarray found in arr[0...i]
        int[] minLens = new int[n];
        Arrays.fill(minLens, Integer.MAX_VALUE);
        
        // Map to store (prefix_sum -> index)
        Map<Integer, Integer> prefixMap = new HashMap<>();
        prefixMap.put(0, -1);
        
        int currentSum = 0;
        int minTotalLength = Integer.MAX_VALUE;
        int currentMinLen = Integer.MAX_VALUE;
        
        for (int i = 0; i < n; i++) {
            currentSum += arr[i];
            prefixMap.put(currentSum, i);
            
            // Maintain the minimum length seen so far up to index i
            if (i > 0) {
                currentMinLen = minLens[i - 1];
            }
            
            // Check if there is a matching prefix sum that yields the target
            if (prefixMap.containsKey(currentSum - target)) {
                int startIdx = prefixMap.get(currentSum - target);
                int currentSubarrayLen = i - startIdx;
                
                // If a valid non-overlapping subarray exists before this one
                if (startIdx >= 0 && minLens[startIdx] != Integer.MAX_VALUE) {
                    minTotalLength = Math.min(minTotalLength, minLens[startIdx] + currentSubarrayLen);
                }
                
                // Track the smallest single subarray length seen so far
                currentMinLen = Math.min(currentMinLen, currentSubarrayLen);
            }
            
            minLens[i] = currentMinLen;
        }
        
        return minTotalLength == Integer.MAX_VALUE ? -1 : minTotalLength;
    }

    // Main method to run and verify test cases
    public static void main(String[] args) {
        Main solver = new Main();
        
        // Test Case 1
        int[] arr1 = {3, 2, 2, 4, 3};
        int target1 = 3;
        System.out.println("Test Case 1 - arr: " + Arrays.toString(arr1) + ", target: " + target1);
        System.out.println("Expected: 2  | Actual: " + solver.minSumOfLengths(arr1, target1));
        System.out.println();
        
        // Test Case 2
        int[] arr2 = {7, 3, 4, 7};
        int target2 = 7;
        System.out.println("Test Case 2 - arr: " + Arrays.toString(arr2) + ", target: " + target2);
        System.out.println("Expected: 2  | Actual: " + solver.minSumOfLengths(arr2, target2));
    }
}
