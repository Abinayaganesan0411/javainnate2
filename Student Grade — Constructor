class Student {

    String name;
    int marks;

    Student(String name, int marks) {
        this.name = name;
        this.marks = marks;
    }

    void display() {
        System.out.println("Name: " + name);
        System.out.println("Marks: " + marks);
    }
}

public class Main {

    public static void main(String[] args) {

        Student s = new Student("Prasanth", 85);

        s.display();
    }
}
