class Calculator {

    int area(int side) {
        return side * side;
    }

    int area(int length, int breadth) {
        return length * breadth;
    }

    double area(double radius) {
        return 3.14 * radius * radius;
    }
}

public class Main {

    public static void main(String[] args) {

        Calculator c = new Calculator();

        System.out.println("Square: " + c.area(5));
        System.out.println("Rectangle: " + c.area(5, 10));
        System.out.println("Circle: " + c.area(5.0));
    }
}
