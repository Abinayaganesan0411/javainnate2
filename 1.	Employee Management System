class Employee {

    int id;
    String name;
    double salary;

    void display() {
        System.out.println("ID: " + id);
        System.out.println("Name: " + name);
        System.out.println("Salary: " + salary);
    }
}

public class Main {

    public static void main(String[] args) {

        Employee e = new Employee();

        e.id = 101;
        e.name = "Prasanth";
        e.salary = 30000;

        e.display();
    }
}
