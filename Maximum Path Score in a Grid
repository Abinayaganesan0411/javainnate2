import java.util.*;

public class Main {

    public static int maxPathScore(int[][] grid, int k) {
        int m = grid.length;
        int n = grid[0].length;

        int[][][] dp = new int[m][n][k + 1];

        for (int[][] row : dp) {
            for (int[] cell : row) {
                Arrays.fill(cell, -1);
            }
        }

        int startCost = grid[0][0] == 0 ? 0 : 1;
        int startScore = grid[0][0];

        if (startCost <= k) {
            dp[0][0][startCost] = startScore;
        }

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if (i == 0 && j == 0) {
                    continue;
                }

                int cost = grid[i][j] == 0 ? 0 : 1;
                int score = grid[i][j];

                for (int c = cost; c <= k; c++) {

                    if (i > 0 && dp[i - 1][j][c - cost] != -1) {
                        dp[i][j][c] = Math.max(
                            dp[i][j][c],
                            dp[i - 1][j][c - cost] + score
                        );
                    }

                    if (j > 0 && dp[i][j - 1][c - cost] != -1) {
                        dp[i][j][c] = Math.max(
                            dp[i][j][c],
                            dp[i][j - 1][c - cost] + score
                        );
                    }
                }
            }
        }

        int answer = -1;

        for (int c = 0; c <= k; c++) {
            answer = Math.max(answer, dp[m - 1][n - 1][c]);
        }

        return answer;
    }

    public static void main(String[] args) {
        int[][] grid = {
            {0, 1},
            {2, 0}
        };

        int k = 1;

        System.out.println("Output: " + maxPathScore(grid, k));
    }
}
